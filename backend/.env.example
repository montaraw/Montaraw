# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database (Supabase Connection String)
# Example Supabase pooled connection string:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require&pgbouncer=true"
# Or direct connection string:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/montaraw?schema=public"

# JWT Secret Key for Authentication
JWT_SECRET="montaraw_luxury_secret_jwt_key_2025_atelier"
JWT_EXPIRES_IN="7d"

# Admin Initial Credentials
DEFAULT_ADMIN_EMAIL="admin@montaraw.com"
DEFAULT_ADMIN_PASS="123456"
